# Bibliome API — Environment Variables
# Copy this to .env and update values.
# Production values live in deploy/env.production.

# ── Core ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bibliome
SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development

# ── Tokens ──
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 30 days per the locked auth-cookie contract (authCookieContract.md).
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend / CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ── Reverse proxies in front of the app ──
# 0 on a dev box (no proxy): trust the socket peer, ignore X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# ── Redis (rate limiting + lockout shared across workers) ──
# Optional in dev — unset falls back to per-process in-memory limiting.
REDIS_URL=

# ── Book search: raises the anonymous quota ceiling ──
GOOGLE_BOOKS_API_KEY=

# ── Transactional email (Resend) ──
# Unset in dev: emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bibliome.app

# ── Pool sizing ──
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SQL_ECHO=0

# ── Build identity (stamped by deploy.sh / update.sh; served at /api/meta/version) ──
GIT_SHA=
