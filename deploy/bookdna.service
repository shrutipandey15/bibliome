[Unit]
Description=Book DNA API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/srv/bookdna/api
EnvironmentFile=/srv/bookdna/api/.env
ExecStart=/srv/bookdna/api/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8100 \
    --workers 2 \
    --log-level info
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/bookdna/api
PrivateTmp=true

[Install]
WantedBy=multi-user.target
