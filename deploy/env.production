# Bibliome — Production Environment
# Generated by deploy.sh. Edit values below; deploy.sh fills the CHANGE_ME slots
# with generated secrets on first run.

# ── Core ──
DATABASE_URL=postgresql+asyncpg://bibliome:CHANGE_ME@localhost:5432/bibliome
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ENVIRONMENT=production

# ── Tokens ──
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 30 days per the locked auth-cookie contract (authCookieContract.md).
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend / CORS (same-origin, so CORS is mostly vestigial) ──
CORS_ORIGINS=https://bibliome.app
FRONTEND_URL=https://bibliome.app

# ── Proxy chain: Cloudflare → cloudflared → nginx → uvicorn ──
# nginx rewrites XFF to a single real IP (see deploy/bibliome.nginx.conf), so 1
# is correct. VERIFY EMPIRICALLY after deploy — see the runbook step
# "Verify real client IP".
TRUSTED_PROXY_COUNT=1

# ── Redis (rate limiting + lockout shared across workers) ──
REDIS_URL=redis://localhost:6379/0

# ── Book search: raises the anonymous quota ceiling ──
GOOGLE_BOOKS_API_KEY=

# ── Transactional email (Resend) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@bibliome.app

# ── Pool sizing (small box) ──
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SQL_ECHO=0

# ── Build identity (stamped by deploy.sh / update.sh; served at /api/meta/version) ──
GIT_SHA=
